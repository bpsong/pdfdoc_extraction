{
  "type": "object",
  "properties": {
    "insurance_company": {
      "type": [
        "string",
        "null"
      ],
      "description": "Issuing insurer from the page header; not the insured."
    },
    "customer": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name in the insured block."
        },
        "address": {
          "type": [
            "string",
            "null"
          ],
          "description": "Address lines in the same insured block."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "address"
      ],
      "description": "The labelled Name and Address of Insured block."
    },
    "coverage_period": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date beside FROM, not Date of Issue."
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date beside TO in the same block."
        }
      },
      "additionalProperties": false,
      "required": [
        "start_date",
        "end_date"
      ],
      "description": "The labelled Period of Insurance FROM/TO block."
    },
    "total_premium": {
      "type": [
        "number",
        "null"
      ],
      "description": "Final Total Premium without currency or masking characters."
    },
    "policy_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Main value beside Policy No."
    },
    "note_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Return debit for Debit Note or credit for Credit Note.",
      "enum": [
        "debit",
        "credit",
        null
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "insurance_company",
    "customer",
    "coverage_period",
    "total_premium",
    "policy_number",
    "note_type"
  ]
